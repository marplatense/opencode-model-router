  },
  "fallback": {
    "global": {
      "openai": [],
      "anthropic": []
    }
  },
  "enforcement": {
    "escalate": {
      "ladder": [
        "fast",
        "medium",
        "complex"
      ],
      "maxAttemptsPerTier": 0,
      "maxTotalAttempts": 3,
      "effortBump": false,
      "variantSteps": "none",
      "costCeiling": {
        "multiple": 10
      }
    }
  },
  "defaultTier": "medium",
  "experimental": {
    "verifiedDelegateTool": false
  }
}
